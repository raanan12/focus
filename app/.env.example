# Public client config. The anon key is safe to ship — Row Level Security protects the data.
# NEVER put the service_role key or any Stripe key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Public https base used inside invite links (the Vercel site, e.g. https://duo-admin.vercel.app)
EXPO_PUBLIC_INVITE_BASE_URL=https://YOUR-VERCEL-DOMAIN
